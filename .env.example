# Optional server defaults. Or configure these per device in AI settings.
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
AI_VISION_MODEL=
AI_SPEECH_MODEL=
AI_SPEECH_VOICE=
AI_IMAGE_MODEL=

# Google sign-in. Create an OAuth Client ID (Web application) in Google Cloud
# Console, add this origin to Authorized JavaScript origins, and put the public
# client ID here. No client secret is needed: the server verifies Google ID
# tokens against Google's published keys. Safe to set as a runtime variable.
# Signed-in readers sync through the Cloudflare D1 binding named DB in
# wrangler.jsonc. Apply its schema with `npm run db:migrate` (remote) or
# `npm run db:migrate:local` (local dev).
GOOGLE_CLIENT_ID=

# The public origin, for canonical and social card URLs.
NEXT_PUBLIC_SITE_URL=https://usegloss.io

# Exa web search, for Fact-check and questions asked with Web on. Optional: without it answers stay inside the text.
EXA_API_KEY=
