{
  "name": "gloss",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --port 3100",
    "build": "next build",
    "start": "next start --port 3100",
    "lint": "tsc --noEmit",
    "db:migrate": "wrangler d1 execute gloss-cn --remote --file=db/schema.sql",
    "desktop:build": "node scripts/desktop-build.mjs",
    "desktop:start": "desktop/out/Gloss/Gloss",
    "desktop:install": "node scripts/desktop-install.mjs",
    "desktop:check": "mise exec github:longbridge/nsh@0.2.0 -- nsh check desktop",
    "test:pdf-pages": "node scripts/test-pdf-pages.mjs",
    "test:ai-provider": "node scripts/test-ai-provider.mjs",
    "test:epub": "node scripts/test-epub.mjs",
    "test:desktop-transfer": "node scripts/test-desktop-transfer.mjs",
    "test:learning": "node scripts/test-learning.mjs",
    "desktop:speech": "node scripts/desktop-speech.mjs",
    "test:pronunciation": "node scripts/test-pronunciation.mjs",
    "cf:build": "opennextjs-cloudflare build",
    "cf:preview": "opennextjs-cloudflare preview",
    "cf:deploy": "opennextjs-cloudflare deploy",
    "test:word-wise": "node scripts/test-word-wise.mjs && node scripts/test-word-wise-source.mjs && node scripts/test-vocabulary-worker.mjs",
    "test:word-wise-reader": "node scripts/test-word-wise-reader.mjs",
    "test:vision": "node scripts/test-vision-models.mjs && node scripts/test-vision-routes.mjs",
    "test:vocabulary-settings": "node scripts/test-vocabulary-settings.mjs",
    "test:answer-markdown": "node scripts/test-answer-markdown.mjs",
    "test:reading-cards": "node scripts/test-reading-cards.mjs",
    "test:ipad": "node scripts/test-ipad-mini.mjs",
    "test:reader-reliability": "node scripts/test-book-settings.mjs && node scripts/test-store-persistence.mjs && node scripts/test-touch-selection.mjs && node scripts/test-shelving.mjs",
    "test:book-open": "node scripts/test-book-open.mjs",
    "test:ui-language": "node scripts/test-ui-language.mjs",
    "test:vocabulary-page": "node scripts/test-vocabulary-page.mjs",
    "db:migrate:local": "wrangler d1 execute gloss-cn --local --file=db/schema.sql",
    "test:google-auth": "node scripts/test-google-auth.mjs",
    "test:word-wise-book": "node scripts/test-word-wise-book.mjs",
    "test:library-dedupe": "node scripts/test-library-dedupe.mjs",
    "test:sync-baseline": "node scripts/test-sync-baseline.mjs",
    "test:sync-guard": "node scripts/test-sync-guard.mjs",
    "test:sync-text": "node scripts/test-sync-text.mjs"
  },
  "dependencies": {
    "@llamaindex/liteparse-wasm": "2.15.1",
    "@mozilla/readability": "^0.6.0",
    "fflate": "^0.8.3",
    "linkedom": "^0.18.13",
    "lucide-react": "^1.53.0",
    "next": "^16.4.3",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.20.13",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "wrangler": "^4.152.0"
  }
}
